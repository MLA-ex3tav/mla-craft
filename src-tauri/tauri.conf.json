{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MLA Server",
  "version": "0.1.0",
  "identifier": "com.mlacraft.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:9999",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MLA Server",
        "width": 1200,
        "height": 780,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "visible": true,
        "backgroundColor": "#0a140e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2QzAzREZGQkEwNDZDNDgKUldSSWJBUzYvejNBbHI3Q1krbVR2eTg1bTlRbnFkdm5nbnIxMXg2bXYxSHBHZDcxdEN1QUFGMGwK",
      "endpoints": [
        "https://github.com/MLA-ex3tav/mla-craft/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
